VITE_DATA_MODE=mock
VITE_DEMO_MODE=true
# Seating stays read-only until real capacities and the quantity API are deployed.
VITE_SEATING_SOURCE=preview
# VITE_SEATING_SOURCE=http
# Public URL of the separately deployed NestJS API, including /api/v1.
# VITE_API_URL=https://your-api.vercel.app/api/v1
# These are public OpenPay browser credentials only. Never use private keys here.
# VITE_OPENPAY_MERCHANT_ID=your_merchant_id
# VITE_OPENPAY_PUBLIC_KEY=pk_your_public_key
# VITE_OPENPAY_SANDBOX=true
